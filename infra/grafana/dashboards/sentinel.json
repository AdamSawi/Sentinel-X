    {
      "id": 7,
      "title": "Température · mesures enregistrées",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sentinel-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT to_timestamp(received_at) AS time, (payload->>'temperature_c')::double precision AS value, device AS metric FROM observations WHERE kind='telemetry' AND $__unixEpochFilter(received_at) ORDER BY received_at",
          "format": "time_series",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Gaz · indice synthétique / déclaré",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sentinel-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT to_timestamp(received_at) AS time, (payload->>'gas_index')::double precision AS value, device AS metric FROM observations WHERE kind='telemetry' AND payload->>'gas_index' IS NOT NULL AND $__unixEpochFilter(received_at) ORDER BY received_at",
          "format": "time_series",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
