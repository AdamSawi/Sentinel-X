        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Rapport · intrusions, anomalies et présences (500 derniers)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sentinel-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT to_timestamp(received_at) AS reception, payload->>'observed_at' AS observation, device AS source, payload->>'event_type' AS evenement, payload->>'zone' AS zone, (payload->>'confidence')::double precision AS confiance, payload->>'simulated' AS simule, payload->>'description' AS description FROM observations WHERE kind='event' AND payload->>'event_type' <> 'heartbeat' AND $__unixEpochFilter(received_at) ORDER BY received_at DESC LIMIT 500",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "title": "Rapport sécurité · rejets constatés par l’API (500 derniers)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sentinel-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT to_timestamp(received_at) AS reception, reason AS motif, transport FROM security_events WHERE $__unixEpochFilter(received_at) ORDER BY received_at DESC LIMIT 500",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 11,
      "title": "Sources · fraîcheur des mesures et heartbeats",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sentinel-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT device AS source, kind AS flux, to_timestamp(max(received_at)) AS derniere_reception, CASE WHEN extract(epoch FROM now())-max(received_at)>15 THEN 'PERIME' ELSE 'RECENT' END AS etat FROM observations WHERE kind='telemetry' OR payload->>'event_type'='heartbeat' GROUP BY device,kind ORDER BY device",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 12,
      "title": "Latence API · percentile 95 (hors scrape)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le, route) (rate(sentinel_http_duration_seconds_bucket[1m])))",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
