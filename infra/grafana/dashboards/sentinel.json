{
  "uid": "sentinel-overview",
  "title": "Sentinel-X · Centre de contrôle",
  "tags": ["sentinel", "monitoring", "vision"],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "refresh": "5s",
  "timezone": "browser",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "CAMÉRA · flux analysé par OpenCV / YOLO",
      "description": "Le flux apparaît quand un notebook de modeles-ia est en cours d’exécution.",
      "type": "text",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 12},
      "options": {
        "mode": "html",
        "content": "<iframe src=\"http://localhost:8090/\" title=\"Caméra Sentinel-X\" style=\"width:100%;height:100%;border:0;background:#05070b\" allow=\"camera; autoplay\"></iframe>"
      }
    },
    {
      "id": 2,
      "title": "État du centre de contrôle",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "sentinel-prometheus"},
      "targets": [
        {"refId": "A", "expr": "up{job=\"sentinel-api\"}", "legendFormat": "API", "instant": true},
        {"refId": "B", "expr": "sentinel_mqtt_connected", "legendFormat": "MQTT", "instant": true},
        {"refId": "C", "expr": "sentinel_database_up", "legendFormat": "Base", "instant": true}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {"0": {"text": "HORS LIGNE", "color": "red"}, "1": {"text": "ACTIF", "color": "green"}}}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "auto"}
    },
    {
      "id": 3,
      "title": "Incidents vision · période sélectionnée",
      "type": "stat",
      "gridPos": {"x": 12, "y": 4, "w": 5, "h": 4},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "sentinel-postgres"},
      "targets": [{"refId": "A", "rawSql": "SELECT count(*) AS incidents FROM observations WHERE kind='event' AND payload->>'event_type' IN ('intrusion','anomaly') AND $__unixEpochFilter(received_at)", "format": "table", "rawQuery": true}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none"}
    },
    {
      "id": 4,
      "title": "Confiance de la dernière détection",
      "type": "stat",
      "gridPos": {"x": 17, "y": 4, "w": 7, "h": 4},
      "datasource": {"type": "prometheus", "uid": "sentinel-prometheus"},
      "targets": [{"refId": "A", "expr": "sentinel_vision_confidence", "legendFormat": "{{model}} · {{device}}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.5}, {"color": "green", "value": 0.8}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 5,
      "title": "Performance IA · temps d’inférence",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "sentinel-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by(model) (rate(sentinel_vision_inference_seconds_sum[1m])) / sum by(model) (rate(sentinel_vision_inference_seconds_count[1m]))", "legendFormat": "{{model}}", "range": true}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "title": "Dernières détections YOLO / visage",
      "type": "table",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "sentinel-postgres"},
      "targets": [{"refId": "A", "rawSql": "SELECT to_timestamp(received_at) AS heure, device AS camera, payload->>'model' AS modele, payload->>'event_type' AS evenement, payload->>'zone' AS zone, (payload->>'detections')::integer AS nombre, (payload->>'confidence')::double precision AS confiance, (payload->>'processing_ms')::double precision AS traitement_ms, payload->>'description' AS description FROM observations WHERE kind='event' AND payload ? 'model' AND $__unixEpochFilter(received_at) ORDER BY received_at DESC LIMIT 100", "format": "table", "rawQuery": true}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true}
    },
    {
      "id": 7,
      "title": "Environnement simulé · température et gaz",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 20, "w": 14, "h": 7},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "sentinel-postgres"},
      "targets": [
        {"refId": "A", "rawSql": "SELECT to_timestamp(received_at) AS time, (payload->>'temperature_c')::double precision AS value, device || ' · °C' AS metric FROM observations WHERE kind='telemetry' AND $__unixEpochFilter(received_at) ORDER BY received_at", "format": "time_series", "rawQuery": true},
        {"refId": "B", "rawSql": "SELECT to_timestamp(received_at) AS time, (payload->>'gas_index')::double precision AS value, device || ' · gaz' AS metric FROM observations WHERE kind='telemetry' AND payload->>'gas_index' IS NOT NULL AND $__unixEpochFilter(received_at) ORDER BY received_at", "format": "time_series", "rawQuery": true}
      ],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 8,
      "title": "Alertes de sécurité récentes",
      "type": "table",
      "gridPos": {"x": 14, "y": 20, "w": 10, "h": 7},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "sentinel-postgres"},
      "targets": [{"refId": "A", "rawSql": "SELECT to_timestamp(received_at) AS heure, reason AS motif, transport FROM security_events WHERE $__unixEpochFilter(received_at) ORDER BY received_at DESC LIMIT 50", "format": "table", "rawQuery": true}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true}
    },
    {
      "id": 9,
      "title": "SIMULATION · faire varier la température",
      "type": "text",
      "gridPos": {"x": 0, "y": 27, "w": 12, "h": 7},
      "options": {"mode": "html", "content": "<iframe src=\"http://localhost:8091/control\" title=\"Simulation thermique\" style=\"width:100%;height:100%;border:0\"></iframe>"}
    },
    {
      "id": 10,
      "title": "Température simulée · dernière mesure reçue",
      "type": "stat",
      "gridPos": {"x": 12, "y": 27, "w": 12, "h": 7},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "sentinel-postgres"},
      "targets": [{"refId": "A", "rawSql": "SELECT (payload->>'temperature_c')::double precision AS temperature FROM observations WHERE kind='telemetry' AND device='thermal-simulator' AND received_at > extract(epoch FROM now())-10 ORDER BY received_at DESC LIMIT 1", "format": "table", "rawQuery": true}],
      "fieldConfig": {"defaults": {"unit": "celsius", "noValue": "Aucune mesure récente", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 70}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none"}
    }
  ],
  "annotations": {"list": []}
}
